generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
  output        = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

////////////////////
/// ENUMS
////////////////////

enum ProductType {
  SIMPLE
  VARIATION
}

enum SupplierType {
  SHOPEE
  LAZADA
  TIKTOK
  OWNED
}

enum OrderStatus {
  PENDING_PAYMENT
  AWAITING_SELLER_CONFIRMATION
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum FulfillmentStatus {
  AWAITING_CONFIRMATION
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum BannerType {
  CONTENT
  RESPONSIVE_IMAGE
}

enum ImageFormat {
  PNG
  JPG
  WEBP
}

////////////////////
/// USER & AUTH
////////////////////

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
  wishlist  Wishlist[]
  orders    Order[]
  addresses ShippingAddress[]
  cartItems CartItem[]
  payments  Payment[]
}

////////////////////
/// SUPPLIERS
////////////////////

model Supplier {
  id         String       @id @default(cuid())
  name       String
  type       SupplierType
  externalId String?
  createdAt  DateTime     @default(now())

  products Product[]
}

////////////////////
/// PRODUCTS
////////////////////

model Product {
  id         String  @id @default(cuid())
  sellerId   String
  supplierId String?

  name        String
  description String?
  specs       String?
  descImg     String[] @default([])
  image       String[]

  category  String      @default("Uncategorized")
  brand     String      @default("Generic")
  sku       String?     @unique
  price     Int?
  salePrice Int?
  costPrice Int?
  stock     Int?
  type      ProductType @default(SIMPLE)

  searchKeys String[] @default([])
  attributes String[] @default([])

  isArchived Boolean @default(false)
  isFeatured Boolean @default(false)
  isOnSale   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller   User      @relation(fields: [sellerId], references: [id], map: "fk_product_seller")
  supplier Supplier? @relation(fields: [supplierId], references: [id], map: "fk_product_supplier")

  variants          ProductVariant[]
  cartItems         CartItem[]
  wishlist          Wishlist[]
  orderItems        OrderItem[]
  stockReservations StockReservation[]

  @@index([sellerId])
  @@index([supplierId])
  @@index([category])
}

model ProductVariant {
  id        String @id @default(cuid())
  productId String

  name       String
  sku        String? @unique
  price      Int?
  salePrice  Int?
  costPrice  Int?
  stock      Int
  imageIndex Int?

  product           Product            @relation(fields: [productId], references: [id], map: "fk_variant_product")
  cartItems         CartItem[]
  orderItems        OrderItem[]
  stockReservations StockReservation[]

  @@index([productId])
}

////////////////////
/// CART & WISHLIST
////////////////////

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  productId String
  variantId String?

  quantity Int @default(1)

  user    User            @relation(fields: [userId], references: [id], map: "fk_cart_user")
  product Product         @relation(fields: [productId], references: [id], map: "fk_cart_product")
  variant ProductVariant? @relation(fields: [variantId], references: [id], map: "fk_cart_variant")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, variantId])
}

model Wishlist {
  id        String @id @default(cuid())
  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id], map: "fk_wishlist_user")
  product Product @relation(fields: [productId], references: [id], map: "fk_wishlist_product")

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

////////////////////
/// ORDERS & FSM
////////////////////

model Order {
  id                String @id @default(cuid())
  userId            String
  shippingAddressId String

  amount    Int
  isPaid    Boolean     @default(false)
  status    OrderStatus @default(PENDING_PAYMENT)
  orderDate DateTime    @default(now())

  user            User            @relation(fields: [userId], references: [id], map: "fk_order_user")
  shippingAddress ShippingAddress @relation(fields: [shippingAddressId], references: [id], map: "fk_order_address")

  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  variantId String?

  quantity Int
  name     String
  price    Int

  supplierOrderId   String?
  courier           String?
  trackingNumber    String?
  fulfillmentStatus FulfillmentStatus @default(AWAITING_CONFIRMATION)

  order   Order           @relation(fields: [orderId], references: [id], map: "fk_order_item_order")
  product Product         @relation(fields: [productId], references: [id], map: "fk_order_item_product")
  variant ProductVariant? @relation(fields: [variantId], references: [id], map: "fk_order_item_variant")

  statusHistory OrderItemStatusHistory[]

  @@index([orderId])
  @@index([productId])
}

model OrderItemStatusHistory {
  id          String @id @default(cuid())
  orderItemId String

  fromStatus FulfillmentStatus
  toStatus   FulfillmentStatus
  actor      String
  note       String?
  createdAt  DateTime          @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], map: "fk_order_item_history")

  @@index([orderItemId])
}

////////////////////
/// PAYMENTS
////////////////////

model Payment {
  id      String @id @default(cuid())
  userId  String
  orderId String @unique

  paymongoPaymentId       String
  paymongoCheckoutId      String
  paymongoPaymentIntentId String

  amount   Int
  tax      Int
  shipping Int
  method   String
  currency String

  payerName  String
  payerEmail String
  payerPhone String

  lineItems Json[]
  date      DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], map: "fk_payment_user")
  order Order @relation(fields: [orderId], references: [id], map: "fk_payment_order")
}

////////////////////
/// SHIPPING
////////////////////

model ShippingAddress {
  id     String @id @default(cuid())
  userId String

  fullName    String
  phoneNumber String
  zipcode     String
  area        String
  city        String
  province    String

  user   User    @relation(fields: [userId], references: [id], map: "fk_address_user")
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

////////////////////
/// STOCK
////////////////////

model StockReservation {
  id        String  @id @default(cuid())
  userId    String
  productId String
  variantId String?

  quantity  Int
  expiresAt DateTime

  fulfilled Boolean @default(false)
  restored  Boolean @default(false)
  meta      Json?

  product Product         @relation(fields: [productId], references: [id], map: "fk_stock_product")
  variant ProductVariant? @relation(fields: [variantId], references: [id], map: "fk_stock_variant")

  createdAt DateTime @default(now())

  @@index([variantId])
}

////////////////////
/// BANNERS
////////////////////

model Banner {
  id Int @id @default(autoincrement())

  type        BannerType
  imageFormat ImageFormat

  title       String?
  offer       String?
  buttonText1 String?
  buttonText2 String?

  imgSrc     String?
  desktopImg String?
  tabletImg  String?
  mobileImg  String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}
