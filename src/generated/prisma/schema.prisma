generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
  output        = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

////////////////////
/// ENUMS
////////////////////

enum ProductType {
  SIMPLE
  VARIATION
}

enum SupplierType {
  SHOPEE
  LAZADA
  TIKTOK
  OWNED
}

enum OrderStatus {
  PENDING_PAYMENT
  AWAITING_SELLER_CONFIRMATION
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum FulfillmentStatus {
  AWAITING_CONFIRMATION
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum BannerType {
  CONTENT
  RESPONSIVE_IMAGE
}

enum ImageFormat {
  PNG
  JPG
  WEBP
}

////////////////////
/// USER & AUTH
////////////////////

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]
  wishlist  Wishlist[]
  orders    Order[]
  addresses ShippingAddress[]
  cartItems CartItem[]
  payments  Payment[]
}

////////////////////
/// SUPPLIERS
////////////////////

model Supplier {
  id         String       @id @default(cuid())
  name       String
  type       SupplierType
  externalId String?
  createdAt  DateTime     @default(now())

  products Product[]
}

////////////////////
/// PRODUCTS
////////////////////

model Product {
  id          String   @id @default(cuid())
  sellerId    String
  name        String
  description String?
  specs       String?
  desc_img    String[] @default([])

  category String   @default("Uncategorized")
  brand    String   @default("Generic")
  image    String[]

  price       Int?
  salePrice   Int?
  search_keys String[]    @default([])
  sku         String?
  stock       Int?
  type        ProductType @default(SIMPLE)
  isArchived  Boolean     @default(false)
  isFeatured  Boolean     @default(false)
  isOnSale    Boolean?    @default(false)
  attributes  String[]    @default(["VarA", "VarB"])

  supplierId String?

  // Pricing control
  costPrice Int? // what YOU pay supplier

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders            OrderItem[]
  wishlist          Wishlist[]
  seller            User               @relation(fields: [sellerId], references: [id])
  cartItems         CartItem[]
  stockReservations StockReservation[]
  variants          ProductVariant[]
  supplier          Supplier?          @relation(fields: [supplierId], references: [id])

  @@unique([sku])
  @@index([supplierId])
  @@index([sellerId])
  @@index([category])
  @@index([search_keys], type: Gin)
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  name       String
  sku        String? @unique
  price      Int?
  salePrice  Int?
  stock      Int
  imageIndex Int?

  // Supplier cost
  costPrice Int?

  product           Product            @relation(fields: [productId], references: [id])
  cartItems         CartItem[]
  orderItems        OrderItem[]
  stockReservations StockReservation[]

  @@index([productId])
}

////////////////////
/// CART & WISHLIST
////////////////////

model CartItem {
  id        String  @id @default(cuid())
  userId    String
  productId String
  variantId String?

  quantity Int @default(1)

  user    User            @relation(fields: [userId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, variantId])
}

model Wishlist {
  id        String @id @default(cuid())
  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

////////////////////
/// ORDERS & FSM
////////////////////

model Order {
  id                String @id @default(cuid())
  userId            String
  shippingAddressId String

  shippingMethod String
  amount         Int
  isPaid         Boolean     @default(false)
  status         OrderStatus @default(PENDING_PAYMENT)
  orderDate      DateTime    @default(now())

  user            User             @relation(fields: [userId], references: [id])
  shippingAddress ShippingAddress? @relation(fields: [shippingAddressId], references: [id])

  items   OrderItem[]
  payment Payment?

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  variantId String?

  quantity Int
  name     String
  price    Int

  supplierOrderId   String?
  courier           String?
  trackingNumber    String?
  fulfillmentStatus FulfillmentStatus @default(AWAITING_CONFIRMATION)

  order   Order           @relation(fields: [orderId], references: [id])
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  statusHistory OrderItemStatusHistory[]

  @@index([orderId])
  @@index([productId])
}

model OrderItemStatusHistory {
  id          String @id @default(cuid())
  orderItemId String

  fromStatus FulfillmentStatus
  toStatus   FulfillmentStatus
  actor      String
  note       String?
  createdAt  DateTime          @default(now())

  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([orderItemId])
}

////////////////////
/// PAYMENTS
////////////////////

model Payment {
  id      String @id @default(cuid())
  userId  String
  orderId String @unique

  paymongoPaymentId       String
  paymongoCheckoutId      String
  paymongoPaymentIntentId String

  amount   Int
  tax      Int
  shipping Int
  method   String
  currency String

  payerName  String
  payerEmail String
  payerPhone String

  lineItems Json[]
  date      DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  order Order @relation(fields: [orderId], references: [id])
}

////////////////////
/// SHIPPING
////////////////////

model ShippingAddress {
  id     String @id @default(cuid())
  userId String

  fullName    String
  phoneNumber String
  zipcode     String
  area        String
  city        String
  province    String
  orders      Order[]
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

////////////////////
/// STOCK
////////////////////

model StockReservation {
  id        String          @id @default(cuid())
  productId String
  variantId String?
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  userId    String
  quantity  Int
  createdAt DateTime        @default(now())
  expiresAt DateTime
  fulfilled Boolean         @default(false)
  restored  Boolean         @default(false)
  meta      Json?

  @@index([variantId])
}

////////////////////
/// BANNERS
////////////////////

model Banner {
  id Int @id @default(autoincrement())

  type        BannerType
  imageFormat ImageFormat

  title       String?
  offer       String?
  buttonText1 String?
  buttonText2 String?

  imgSrc     String?
  desktopImg String?
  tabletImg  String?
  mobileImg  String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}
